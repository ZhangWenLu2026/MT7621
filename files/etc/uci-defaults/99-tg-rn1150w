#!/bin/sh
#
# TG RN1150W 首次启动配置（DSA 版）
# MT7621 在 OpenWrt 24.10 用 DSA，不再有 swconfig 的 switch_vlan。
# 实测拓扑（两台机器都验证过）：
#   面板 1/2/3/4 号 = MT7530 的 lan5/lan4/lan3/lan2（直连，非阻塞）
#   面板 5/6/7/8 号 = RTL8367SB 的 4 个口，共用 MT7530 PHY0 (lan1) 这条 1G 上行
# 所以把 lan1..lan5 桥进 br-lan，8 个物理口全部可用。
# lan6 是 MT7530 port5 的幽灵接口，没有实际连接，不加入网桥。

cat > /etc/config/network <<'EOF'
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'auto'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'lan5'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
EOF

uci -q set system.@system[0].hostname='RN1150W'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q commit system

# 让上面的配置立即生效（首次启动时会短暂断网一次）
/etc/init.d/network restart

# 首次启动时 dnsmasq 可能早于 br-lan 就绪，生成出来的配置里没有 dhcp-range，
# 结果只能当 DNS、不发 IP（必须手动重启 dnsmasq 才恢复）。这里强制重启一次。
sleep 2
/etc/init.d/dnsmasq restart

exit 0
