#!/bin/sh
#
# TG-RN1150W 首次启动配置（覆盖 board.d 生成的结果）
# 目的：MT7530 的 5 个口全部划进同一 VLAN = 纯交换机模式
#
# 端口对应（原厂 /etc/uic-defaults/02_network 的 llllw 布局）:
#   port0      = 内部 PHY 链路 -> RTL8367SB（面板上另外几个口）
#   port1..4   = 面板 LAN / WAN 口
#   port6      = CPU（对应 eth0）
#
cat > /etc/config/network <<'EOF'
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'auto'

config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'

config switch_vlan
	option device 'switch0'
	option vlan '1'
	option ports '0 1 2 3 4 6t'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0.1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.250'
	option netmask '255.255.255.0'
EOF

uci -q set system.@system[0].hostname='RN1150W'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q commit system

exit 0
